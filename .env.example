# ============================================================
# API credentials
# ============================================================

# Required only for pipeline stages that use the OpenAI API.
OPENAI_API_KEY=


# ============================================================
# External S2ORC data
# ============================================================

# Local directories containing the S2ORC source files.
# These large datasets are not distributed with the repository.
S2ORC_DATA_0_80=
S2ORC_DATA_81_269=


# ============================================================
# Spark runtime
# ============================================================

# Optional. If unset, the repository uses:
# <repository>/.cache/spark_checkpoints
SPARK_CHECKPOINT_DIR=
